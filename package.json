{
  "name": "dropit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,sig -c cyan,magenta \"next dev\" \"npm:server\"",
    "server": "tsx watch server/signaling/index.ts",
    "server:start": "tsx server/signaling/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e.mjs",
    "start:prod": "SIGNALING_PORT=${SIGNALING_PORT:-4000} concurrently -k -n web,sig -c cyan,magenta \"npm:start\" \"npm:server:start\""
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.63.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
