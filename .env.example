# ---- Web app (Next.js) -------------------------------------------------
# Public origin of the web app. Used for building share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Signaling server (Socket.IO) URL. Use wss:// in production.
# Set it to an EMPTY value to use the same origin as the web app (the web
# server or reverse proxy then forwards /socket.io, /config and /health).
NEXT_PUBLIC_SIGNALING_URL=http://localhost:4000

# ---- Signaling server --------------------------------------------------
# Port for the signaling server. SIGNALING_PORT wins over PORT so a single
# process group can run the web app on PORT and signaling on SIGNALING_PORT.
SIGNALING_PORT=4000
# PORT=4000

# Comma separated list of origins allowed to call the signaling server.
# Required when the web app and signaling live on different origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Honour x-forwarded-for when the signaling server sits behind a reverse
# proxy or a platform router. Leave it off when it is exposed directly,
# otherwise clients can spoof their address and bypass rate limits.
TRUST_PROXY=1

# Comma separated STUN server URLs.
# Alias also accepted: NEXT_PUBLIC_STUN_SERVER
STUN_SERVERS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# Comma separated TURN server URLs (turn: / turns:). Leave empty to disable.
# Aliases also accepted: NEXT_PUBLIC_TURN_SERVER / NEXT_PUBLIC_TURN_USERNAME /
# NEXT_PUBLIC_TURN_PASSWORD
# Example: turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SERVERS=

TURN_USERNAME=
TURN_CREDENTIAL=

# ---- Room limits (seconds unless stated) -------------------------------
MAX_PEERS=10
ROOM_TTL=21600
HOST_IDLE_TIME=3600
PEER_IDLE_TIME=1800
EMPTY_ROOM_GRACE=60

# ---- Development -------------------------------------------------------
LOG_LEVEL=debug
